# Swastya Assist V10 environment template
# Local laptop defaults are intentionally HTTP-friendly. Never commit your real .env.

# Database: leave blank for local SQLite (triage.db). On Vercel use managed PostgreSQL.
DATABASE_URL=
# REQUIRED on Vercel: use a managed PostgreSQL URL (for example Neon/Supabase/other Postgres provider).

# Keep these FIXED during local testing. Replace with long random secrets on Vercel.
FLASK_SECRET_KEY=local-change-me-keep-fixed
LOGIN_CSRF_SECRET=local-login-change-me-keep-fixed

# Initial administrator for a fresh database. Existing accounts are not overwritten.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-12-plus-character-password
# Local-only convenience. Set 1 to reset the local admin password from ADMIN_PASSWORD at startup; never use on Vercel.
LOCAL_RESET_ADMIN_PASSWORD=0

# Optional locally; REQUIRED on Vercel readiness. Generate with the command in README.
DATA_ENCRYPTION_KEY=
REDIS_URL=
RATELIMIT_STORAGE_URI=

# Gemini AI. Put the real API key in .env only, never .env.example.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
GEMINI_VOICE_MODEL=gemini-3.5-flash-lite
# Automatic fallback/retry is disabled: one provider POST per user AI attempt.
GEMINI_FALLBACK_MODELS=
GEMINI_VOICE_FALLBACK_MODEL=
GEMINI_RETRY_ATTEMPTS=1
GEMINI_RETRY_BASE_SECONDS=0
GEMINI_GENERATE_API_VERSION=v1beta
# Deprecated compatibility variable; ignored by the AI transport.
GEMINI_API_VERSION=

# Retention cron. REQUIRED on Vercel.
CRON_SECRET=
RETENTION_DAYS=30

# Local-first defaults. Set COOKIE_SECURE=1 on HTTPS/Vercel.
DEFAULT_FACILITY_ID=SYN-FAC-001
DEFAULT_FACILITY_NAME=Synthetic Demonstration Health Facility
DEMO_ONLY_MODE=1
SEED_DEMO_DATA=1
COOKIE_SECURE=0
MAX_UPLOAD_MB=4
LOG_LEVEL=INFO

# Local memory limiter is fine for one laptop. On Vercel use redis:// or rediss://.

# Test-only flag used by pytest to keep test env variables ahead of local .env values.
SWASTYA_TEST_MODE=0

# Reject clearly non-health text/files before sending them to Gemini.
HEALTH_INPUT_GATE=1

# Default-on privacy gate: separate consent before original report media or raw audio can be sent to Gemini.
PRIVACY_GATE_ENABLED=1
