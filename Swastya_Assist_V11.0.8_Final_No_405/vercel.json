{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": { "maxDuration": 180 }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/maintenance/retention", "schedule": "0 3 * * *" }
  ]
}
